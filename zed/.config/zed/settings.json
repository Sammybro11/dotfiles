// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "which_key": {
    "enabled": true
  },
  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "tree_view": true
  },
  "diff_view_style": "unified",
  "git": {
    "diff_base": "head"
  },
  "autosave": "on_focus_change",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },
  "vim_mode": true,
  "icon_theme": "Catppuccin Latte",
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark Hard",
  },
  "language_models": {
    "openai_compatible": {
      "hyper": {
        "api_url": "https://hyper.charm.land/v1",
        "available_models": [
          {
            "name": "kimi-k3",
            "display_name": "Kimi K3",
            "max_tokens": 150000,
            "max_completion_tokens": 32000,
            "capabilities": {
              "chat_completions": false,
              "images": true,
              "interleaved_reasoning": true,
              "tools": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          },
          {
            "name": "glm-5.3-flash",
            "display_name": "GLM 5.3 Flash",
            "max_tokens": 150000,
            "max_completion_tokens": 32000,
            "capabilities": {
              "chat_completions": false,
              "images": true,
              "interleaved_reasoning": true,
              "tools": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          },
          {
            "name": "qwen3.8-max",
            "display_name": "Qwen 3.8 Max",
            "max_tokens": 150000,
            "max_completion_tokens": 32000,
            "capabilities": {
              "chat_completions": false,
              "images": true,
              "interleaved_reasoning": true,
              "tools": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "write_file": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^cat\\s+pyproject\\.toml(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^ls\\s+\\~/\\.config/ruff(\\s|$)"
            },
            {
              "pattern": "^ruff\\s+check(\\s|$)"
            },
            {
              "pattern": "^echo\\s+no(\\s|$)"
            },
            {
              "pattern": "^echo\\s+CLEAN(\\s|$)"
            },
            {
              "pattern": "^echo\\b"
            },
            {
              "pattern": "^grep\\s+s2(\\s|$)"
            }
          ]
        }
      }
    },
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "terminal_init_command": "crush",
    "play_sound_when_agent_done": "when_hidden",
    "single_file_review": true,
    "threads_sidebar": {
      "auto_open": false
    },
    "favorite_models": [
      {
        "provider": "hyper",
        "model": "glm-5.3-flash",
        "enable_thinking": false
      },
      {
        "provider": "hyper",
        "model": "kimi-k3",
        "enable_thinking": false
      }
    ],
    "default_profile": "write",
    "default_model": {
      "provider": "hyper",
      "model": "glm-5.3-flash",
    },
    "inline_assistant_model": {
      "provider": "hyper",
      "model": "glm-5.3-flash",
    },
  }
}
