[user]
	name = Samyak
	email = srai890890@gmail.com
	signingkey = /Users/samyakrai/.ssh/id_ed25519.pub
[credential]
	helper = osxkeychain
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	autocrlf = input
[gpg]
	format = ssh
[commit]
	gpgSign = true
